# --- S3 (required) ---
S3_ENDPOINT_URL=https://minio.example.kz
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme

# --- S3 bucket scanner (optional; enabled when S3_SCAN_URL is set) ---
# Alternative to BPM's POST /requestTranscription: poll a bucket/prefix and queue
# every NEW .mp3/.wav object once (seen keys are kept in the job DB, so each scan
# is incremental and survives restarts). Scanned jobs get a stable UUID
# CallRecordId derived from the object path; BPM does not know these ids, so
# deliver them by email (the message shows the file path).
#S3_SCAN_URL=s3://call-records/2026/
#S3_SCAN_INTERVAL_SECONDS=300
# ignore objects last modified before this ISO 8601 date/time (UTC if no zone),
# e.g. to skip the historical backlog on the first scan
#S3_SCAN_MODIFIED_AFTER=2026-09-01T00:00:00Z

# --- Delivery channels: BPM and/or email (at least one is required) ---
# Each channel is enabled by setting its variables; with both set the result is
# sent to both. A channel that already accepted a result is not resent on retry.

# --- BPM callback (enabled when BPM_CALLBACK_URL is set) ---
# base URL of the BPM host only; the result is POSTed to
# {BPM_CALLBACK_URL}/0/ServiceModel/AnGetTranscriptionResultService.svc/transcriptions/{CallRecordId}/result
BPM_CALLBACK_URL=http://mow2crm6:5000
# optional CSRF token; when set, sent to BPM as the x-api-key request header
#BPM_CSRF_TOKEN=

# --- Email via SMTP (enabled when SMTP_HOST / EMAIL_TO is set; then SMTP_HOST,
# EMAIL_FROM and EMAIL_TO are all required) ---
# The message carries the Summary and FullText in the body plus FullText as a
# {CallRecordId}.txt attachment; a failed job is reported with the error reason.
#SMTP_HOST=smtp.example.kz
#SMTP_SECURITY=starttls  # starttls | ssl | none
#SMTP_PORT=              # empty = by SMTP_SECURITY: 587 starttls, 465 ssl, 25 none
#SMTP_USERNAME=          # empty = no AUTH
#SMTP_PASSWORD=
#SMTP_TIMEOUT_SECONDS=30
#EMAIL_FROM=stt@example.kz
#EMAIL_TO=ops@example.kz,qa@example.kz   # comma-separated

# --- Summarization ---
SUMMARY_ENABLED=true
# required when SUMMARY_ENABLED=true:
LLM_API_URL=http://vllm.example.kz:8000/v1
LLM_MODEL=qwen2.5-32b-instruct
#LLM_API_KEY=
#LLM_TIMEOUT_SECONDS=120
# false = accept self-signed / IP-mismatched TLS certs of the LLM endpoint
# (traffic stays encrypted, but the server is not authenticated)
#LLM_VERIFY_SSL=true
# JSON object merged into the chat/completions request (overrides built-in fields
# like temperature; model/messages are not allowed). Use SINGLE quotes in .env.
# Disable thinking of Qwen3-family models on vLLM/SGLang and cap the answer:
#LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false},"max_tokens":1024}'
#SUMMARY_PROMPT=
# known client companies → corporate e-mail domain, rendered into SUMMARY_PROMPT
# at the {KNOWN_EMAIL_DOMAINS} placeholder (appended as a last sentence when the
# prompt has none). Format: "Company|Alias=domain.ru; Other=other.com"
#KNOWN_EMAIL_DOMAINS=Аэроклуб|Аэроклуб ИТ=aeroclub.ru; Ромашка=romashka-group.ru

# --- Whisper endpoint (consumed by ai-service) ---
# `docker compose up` runs ai-service only: point it at an external whisper-api
# (OpenAI-compatible base URL including /v1). Leave unset with
# `docker compose --profile local-whisper up` — the default then targets the
# whisper-api container built by compose.
#WHISPER_API_URL=https://whisper.example.kz/v1

# --- Whisper (compose passes these to the local whisper-api; profile local-whisper) ---
#WHISPER_MODEL=large-v3
#DEVICE=cuda            # cuda | cpu
#COMPUTE_TYPE=          # empty = auto (float16 for cuda, int8 for cpu)
#VAD_FILTER=true        # Silero VAD trims silence/hold music (fewer hallucinations)
#CONDITION_ON_PREVIOUS_TEXT=false  # false avoids repetition loops on phone audio
# open JSON object of faster-whisper transcribe options, merged over the tuned
# defaults; lets you tune any option without a rebuild. A supplied vad_parameters
# replaces the default one wholesale. Invalid JSON / non-object fails startup.
#TRANSCRIBE_OPTIONS={"beam_size":5,"temperature":0,"vad_parameters":{"min_silence_duration_ms":500}}
# optional TLS: set BOTH to serve HTTPS (paths inside the whisper-api container);
# unset = plain HTTP. Mount the certs via docker-compose (see the commented block),
# or set the paths without mounting anything — the container entrypoint then
# generates a self-signed cert there on startup (DOMAIN is its CN).
#SSL_CERTFILE=/certs/cert.pem
#SSL_KEYFILE=/certs/key.pem
#SSL_KEYFILE_PASSWORD=
#DOMAIN=llm.example.int
# setting this secures whisper-api's API; ai-service reads the same value
# via env_file and sends it as its own Bearer token automatically, so it
# no longer needs to stay empty
#WHISPER_API_KEY=

# --- Whisper (consumed by ai-service, not passed to whisper-api) ---
#WHISPER_TIMEOUT_SECONDS=600
# false = accept self-signed / IP-mismatched TLS certs of whisper-api, e.g. an
# ephemeral GPU instance whose entrypoint generated a cert on startup
#WHISPER_VERIFY_SSL=true
# vocabulary/style hint sent as the OpenAI `prompt` field (faster-whisper
# initial_prompt): helps Whisper write dictated e-mails with "@" and domain names.
# Keep it short (~220 tokens are used) and use made-up example addresses —
# Whisper may copy prompt text into silent stretches.
#WHISPER_PROMPT=Клиент диктует корпоративную почту, например: ivan.petrov@aeroclub.ru, anna-smirnova@company.com. Компания Аэроклуб, aeroclub.ru.
#LANGUAGE=ru

# --- Service tuning (defaults shown) ---
#MAX_RETRIES=3
#RETRY_BACKOFF_CAP_SECONDS=300
#CALLBACK_TIMEOUT_SECONDS=30
#DB_PATH=/data/jobs.db
#AI_SERVICE_PORT=8080
#LOG_LEVEL=INFO
# listen ports are fixed inside compose (ai-service 8080, whisper-api 8000);
# the PORT env var applies only when running a service standalone
